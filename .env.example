OPENAI_API_KEY=
OPENAI_MODEL=
DATABASE_URL=sqlite:///retail_agent.db
APP_ENV=development
# Shared demo gate. In APP_ENV=development, defaults to infolob-demo when empty.
# Only used when AUTH_PROVIDER=demo. Never expose this value in UI/logs/API responses.
DEMO_ACCESS_CODE=

# Authentication / session (demo provider only in this deployment)
AUTH_PROVIDER=demo
SESSION_TTL_MINUTES=480
# Optional signing secret for application sessions (dev default used when empty).
SESSION_SECRET=
# Future OIDC placeholders — unused until an OIDC provider is registered.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=

TRACE_INCLUDE_SENSITIVE_DATA=false
# Backward-compatible alias; TRACE_INCLUDE_SENSITIVE_DATA takes precedence when set.
TRACE_SENSITIVE_DATA=false
AGENT_TRACING_DISABLED=false
AGENT_MAX_TURNS=12
FOLLOW_UP_MAX_TURNS=8
AGENT_SESSION_DB_PATH=
HITL_RESUME_TTL_MINUTES=120
MAX_AGENT_RUNS_PER_USER_PER_HOUR=20
RATE_LIMIT_WINDOW_MINUTES=60
# Scheduled replenishment (CLI / Render cron). Empty CRON_SECRET = no secret locally.
CRON_SECRET=
REPLENISHMENT_SCHEDULE_ENABLED=true
REPLENISHMENT_CRON=0 */6 * * *
REPLENISHMENT_TIMEZONE=UTC
REPLENISHMENT_RUN_INTERVAL_HOURS=6
REPLENISHMENT_STALE_TOLERANCE_MINUTES=90
# Agent Operations / System Health — Agent Runtime thresholds
AGENT_OPS_FAILED_WINDOW_HOURS=24
AGENT_OPS_FAILED_DEGRADED_THRESHOLD=5
AGENT_OPS_WAITING_DEGRADED_THRESHOLD=20
AGENT_OPS_LIST_DEFAULT_LIMIT=100
# Legacy aliases (still honored if canonical names are unset):
# BATCH_SCHEDULE_CRON=0 */6 * * *
# BATCH_SCHEDULE_TIMEZONE=UTC
ERP_ADAPTER=mock
ERP_PROVIDER=mock
ERP_MOCK_FORCE_FAIL=false
# ERP lifecycle (queue ≠ transmit). Auto-transmit stays off by default.
ERP_AUTO_TRANSMIT=false
ERP_MAX_RETRY_ATTEMPTS=3
ERP_RETRY_DELAY_SECONDS=60
# Mock scenarios: success | temporary_failure | business_rejection | timeout
ERP_MOCK_SCENARIO=success
# Enterprise integration providers (this deployment supports csv/demo/mock only)
INVENTORY_PROVIDER=csv
SALES_PROVIDER=csv
PRODUCT_PROVIDER=csv
SUPPLIER_PROVIDER=demo
# Unknown values fail fast — no silent fallback to mock/csv.

# Enterprise Memory & Knowledge Engine (SQL only today; vector backends later)
# Supported: database | mock — unknown values fail fast.
MEMORY_PROVIDER=database
MEMORY_RETRIEVAL_DEFAULT_LIMIT=10
MEMORY_RETRIEVAL_MAX_LIMIT=50

# Semantic Retrieval / RAG (extends memory/; structured memory stays authoritative)
# Unknown EMBEDDING_PROVIDER values fail fast. External vector DBs are not implemented yet.
RAG_ENABLED=true
EMBEDDING_PROVIDER=mock
RAG_MAX_RESULTS=5
RAG_MAX_CONTEXT_CHARS=4000
RAG_MIN_SCORE=0.15

# Enterprise LLM Orchestration Layer
# Supported: mock | openai — unknown values fail fast.
# OpenAI remains disabled unless OPENAI_API_KEY is set when LLM_PROVIDER=openai.
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=60
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.0
LLM_ENABLE_TOOL_CALLS=true

# Enterprise Planning & Task Graph Engine
# Supported: mock | rules — unknown values fail fast.
PLANNER_PROVIDER=mock
PLANNER_MAX_PARALLEL=4
PLANNER_MAX_DEPTH=16
PLANNER_ENABLE_PARALLEL=true

# Enterprise Decision Intelligence Engine
# Supported strategies: balanced | lowest_risk | lowest_cost | fastest_delivery |
# business_policy_first | mock — unknown values fail fast.
# LLM advisor is optional and cannot override policy/RBAC/approvals/ERP.
DECISION_ENABLED=true
DECISION_STRATEGY=balanced
DECISION_LLM_ADVISOR=false
DECISION_CONFIDENCE_FLOOR=0.45
DECISION_RISK_CEILING=0.75

# Enterprise Tool Execution & Workflow Automation Engine
# Coordinates planner Plans; checkpoints reuse AgentRunStateRow.state_json (no new tables).
WORKFLOW_ENABLED=true
WORKFLOW_MAX_PARALLEL=4
WORKFLOW_DEFAULT_TIMEOUT_SECONDS=120
WORKFLOW_RETRY_LIMIT=3
WORKFLOW_CHECKPOINTS_ENABLED=true
WORKFLOW_COMPENSATION_ENABLED=false

# Enterprise Event Bus & Distributed Runtime (in-process)
# Supported EVENT_PROVIDER: in_process | mock — Kafka/RabbitMQ/Service Bus/SQS not implemented.
# Fail-soft: bus unavailable → sync fallback; business mutations are never lost.
EVENT_ENABLED=true
EVENT_PROVIDER=in_process
EVENT_RETRY_LIMIT=3
EVENT_MAX_WORKERS=2
EVENT_ORDERING=true
EVENT_DEAD_LETTER=true
# Prefer false in production (async workers); true for deterministic tests/demos.
EVENT_SYNC_DISPATCH=false
