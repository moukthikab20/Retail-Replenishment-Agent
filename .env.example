OPENAI_API_KEY=
OPENAI_MODEL=
DATABASE_URL=sqlite:///retail_agent.db
APP_ENV=development
# Shared demo gate. In APP_ENV=development, defaults to infolob-demo when empty.
DEMO_ACCESS_CODE=
TRACE_INCLUDE_SENSITIVE_DATA=false
# Backward-compatible alias; TRACE_INCLUDE_SENSITIVE_DATA takes precedence when set.
TRACE_SENSITIVE_DATA=false
AGENT_TRACING_DISABLED=false
AGENT_MAX_TURNS=12
FOLLOW_UP_MAX_TURNS=8
AGENT_SESSION_DB_PATH=
HITL_RESUME_TTL_MINUTES=120
MAX_AGENT_RUNS_PER_USER_PER_HOUR=20
RATE_LIMIT_WINDOW_MINUTES=60
