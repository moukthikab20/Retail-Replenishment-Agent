{
  "version": 1,
  "description": "Follow-up evaluation cases — structured outcomes, not prose similarity.",
  "cases": [
    {
      "id": "explain_recommendation",
      "scenario": "explain recommendation",
      "input": {
        "question": "Why is the recommendation this quantity?",
        "user_id": "alex.store",
        "create_recommendation": true,
        "store_id": "ST001",
        "sku": "SKU-1001"
      },
      "expected_status": "completed",
      "expected_question_type": "explanation",
      "expected_tools": ["get_recommendation"],
      "prohibited_tools": [
        "create_mock_purchase_order",
        "create_approval_request",
        "create_recommendation_record"
      ],
      "required_verified_facts": ["agent_recommended_quantity=", "recommendation_id="],
      "expected_scenario_fields": null,
      "expected_prohibition": null,
      "expect_recommendation_unchanged": true,
      "expect_can_change_business_state": false
    },
    {
