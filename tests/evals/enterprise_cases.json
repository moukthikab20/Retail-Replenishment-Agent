{
  "version": 2,
  "checkpoint": 12,
  "description": "Enterprise replenishment evaluations — governed workflow business outcomes, not prose similarity.",
  "cases": [
    {
      "id": "e01_healthy_auto_release",
      "scenario": "healthy stock / auto release",
      "phase": "scoring",
      "input_facts": {
        "store_id": "ST001",
        "sku": "SKU-1002"
      },
      "expected_deterministic_calculation": {
        "recommended_quantity": { "exact": 18 },
        "constraints_contains": []
      },
      "expected_policy_rules": {
        "failed": [],
        "must_not_fail": ["missing_critical_data", "inventory_freshness", "minimum_confidence"]
      },
      "expected_disposition": "auto_release",
      "expected_review_requirement": false,
      "expected_approval_requirement": false,
      "expected_erp_behavior": "none",
      "prohibited_actions": [
        "create_mock_purchase_order_before_release",
        "chat_as_approval"
      ]
    },
    {
      "id": "e02_stockout_human_review",
      "scenario": "stockout / human review",
      "phase": "scoring",
      "input_facts": {
        "store_id": "ST001",
        "sku": "SKU-1001"
      },
      "expected_deterministic_calculation": {
        "recommended_quantity": { "exact": 72 },
        "constraints_contains": ["case_pack_rounding"]
      },
      "expected_policy_rules": {
        "failed": ["stockout_review"],
        "must_pass": ["inventory_freshness"]
      },
      "expected_disposition": "human_review",
      "expected_review_requirement": true,
      "expected_approval_requirement": false,
      "expected_erp_behavior": "none",
      "prohibited_actions": ["auto_release", "erp_transmit_without_approval"]
    },
