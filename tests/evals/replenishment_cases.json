{
  "version": 1,
  "description": "Retail replenishment agent evaluation cases — structured outcomes, not prose similarity.",
  "cases": [
    {
      "id": "normal_stockout",
      "scenario": "normal stockout",
      "phase": "analysis",
      "input": { "store_id": "ST001", "sku": "SKU-1001" },
      "expected_tools": [
        "get_product_details",
        "get_inventory_position",
        "get_open_orders",
        "get_demand_forecast",
        "calculate_replenishment",
        "assess_replenishment_risk",
        "create_recommendation_record"
      ],
      "prohibited_tools": ["create_mock_purchase_order", "create_approval_request"],
      "expected_risk": "stockout",
      "expected_quantity": { "exact": 72 },
      "expected_next_action": "review_recommendation",
      "expected_approval_behavior": { "analysis_only": true }
    },
    {
      "id": "balanced_inventory",
      "scenario": "balanced inventory",
      "phase": "analysis",
      "input": { "store_id": "ST001", "sku": "SKU-1002" },
      "expected_tools": [
        "get_product_details",
        "get_inventory_position",
        "get_open_orders",
        "get_demand_forecast",
        "calculate_replenishment",
        "assess_replenishment_risk",
        "create_recommendation_record"
      ],
      "prohibited_tools": ["create_mock_purchase_order"],
      "expected_risk": "balanced",
      "expected_quantity": { "exact": 18 },
      "expected_next_action": "review_recommendation",
      "expected_approval_behavior": { "analysis_only": true }
    },
    {
      "id": "overstock",
      "scenario": "overstock",
      "phase": "analysis",
      "input": {
        "store_id": "ST002",
        "sku": "SKU-1003",
        "patches": ["force_overstock"]
      },
      "expected_tools": [
        "get_product_details",
        "get_inventory_position",
        "get_open_orders",
        "get_demand_forecast",
        "calculate_replenishment",
        "assess_replenishment_risk",
        "create_recommendation_record"
      ],
      "prohibited_tools": ["create_mock_purchase_order"],
      "expected_risk": "overstock",
      "expected_quantity": { "exact": 0 },
      "expected_next_action": "no_order_required",
      "expected_approval_behavior": { "analysis_only": true }
    },
    {
      "id": "zero_sales",
      "scenario": "zero sales",
      "phase": "analysis",
      "input": {
        "store_id": "ST001",
        "sku": "SKU-1001",
