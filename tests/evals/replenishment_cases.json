    {
      "id": "zero_human_proposal",
      "scenario": "zero human proposal",
      "phase": "review",
      "input": {
        "store_id": "ST001",
        "sku": "SKU-1001",
        "choice": "manual",
        "human_proposed_quantity": 0,
        "override_reason": "Promo ended; hold orders",
        "submitter_role": "inventory_planner"
      },
      "expected_tools": [],
      "prohibited_tools": ["create_mock_purchase_order"],
      "expected_risk": null,
      "expected_quantity": { "exact": 72 },
      "expected_next_action": null,
      "expected_approval_behavior": {
        "review_valid": true,
        "human_proposed_quantity": 0,
        "agent_recommended_quantity_unchanged": true,
        "requires_escalation": true,
        "required_role": "category_manager"
      }
    },
