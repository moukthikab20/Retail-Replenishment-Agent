      },
      "expected_tools": [
        "get_product_details",
        "get_inventory_position",
        "get_open_orders",
        "get_demand_forecast",
        "calculate_replenishment",
        "assess_replenishment_risk",
        "create_recommendation_record"
      ],
      "prohibited_tools": ["create_mock_purchase_order"],
      "expected_risk": ["overstock", "balanced", "insufficient_data"],
      "expected_quantity": { "max": 24 },
      "expected_next_action": ["no_order_required", "review_recommendation", "manual_data_review"],
      "expected_approval_behavior": { "analysis_only": true }
    },
